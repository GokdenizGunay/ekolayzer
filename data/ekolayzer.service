[Unit]
Description=Ekolayzer - sistem geneli ses ekolayzeri ve limiter (PipeWire filtresi)
After=pipewire.service wireplumber.service
Requires=pipewire.service
PartOf=pipewire.service

[Service]
Type=simple
ExecStart=/usr/lib/ekolayzer/ekolayzer-daemon
Restart=on-failure
RestartSec=2
Slice=session.slice

[Install]
WantedBy=pipewire.service default.target
