#!/bin/sh
set -e
case "$1" in
    remove|purge)
        rm -f /etc/systemd/user/pipewire.service.wants/ekolayzer.service /etc/systemd/user/default.target.wants/ekolayzer.service
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications || true
        fi
        ;;
esac
exit 0
