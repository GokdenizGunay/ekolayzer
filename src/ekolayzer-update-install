#!/bin/sh
# pkexec ile root olarak çalışır: indirilen Ekolayzer paketini doğrulayıp kurar.
# Yalnızca "ekolayzer" adlı ve yüklü sürümden yeni bir paketi kabul eder.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

f="${1:-}"
case "$f" in
    /*.deb) ;;
    *) echo "Geçersiz paket yolu." >&2; exit 2 ;;
esac
if [ ! -f "$f" ] || [ -L "$f" ]; then
    echo "Paket dosyası bulunamadı." >&2
    exit 2
fi

# Kullanıcının değiştiremeyeceği bir kopya üzerinde çalış
tmp=$(mktemp -d /tmp/ekolayzer-update.XXXXXX)
trap 'rm -rf "$tmp"' EXIT
chmod 755 "$tmp"
cp -- "$f" "$tmp/ekolayzer.deb"
chmod 644 "$tmp/ekolayzer.deb"

pkg=$(dpkg-deb -f "$tmp/ekolayzer.deb" Package 2>/dev/null || true)
if [ "$pkg" != "ekolayzer" ]; then
    echo "Bu dosya bir Ekolayzer paketi değil." >&2
    exit 3
fi
new=$(dpkg-deb -f "$tmp/ekolayzer.deb" Version)
cur=$(dpkg-query -W -f='${Version}' ekolayzer 2>/dev/null || echo 0)
if ! dpkg --compare-versions "$new" gt "$cur"; then
    echo "Paket ($new) yüklü sürümden ($cur) yeni değil." >&2
    exit 4
fi

DEBIAN_FRONTEND=noninteractive apt-get install -y -q "$tmp/ekolayzer.deb"
